post_install() {
  cat <<'EOF'
Minflair is installed in /usr/share/minflair.

Deploy the configuration to your home directory with:

  minflair install

Use `minflair install --help` to see the component selection flags. The
interactive selector opens by default when no flags are given.
EOF
}

post_upgrade() {
  cat <<'EOF'
Minflair package files were updated.

Run `minflair update` to copy the new configuration into your home directory.
Your component preferences in ~/.config/minflair/preferences.conf are kept.
EOF
}
