post_install() {
  cat <<'EOF'
==> Minflair is installed.

Run `minflair install` as your normal user to deploy the desktop configuration.

Update with `sudo pacman -Syu` and then `minflair update`.
Do not pass --pull: the source is managed by pacman, not by git.

If you previously installed with bootstrap.sh, remove ~/.config/minflair/repo
so the packaged copy in /usr/share/minflair is used.
EOF
}

post_upgrade() {
  post_install
}
